# ========================================================
# ATLAS 2.0 - Production Environment Configuration
# ========================================================

# OpenRouter AI API Key (required for Math AI, Tutor Q&A, and Vision OCR)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Allowed Frontend Origins for CORS (comma-separated, e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=https://localhost:5173,https://your-frontend-app.vercel.app

# Custom SQLite Database Path (Optional: defaults to backend/atlas.db)
DATABASE_FILE=atlas.db

# ========================================================
# SMTP Email Settings for Secure One-Time Password (OTP)
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=ATLAS 2.0 Security
SMTP_FROM_EMAIL=your_email@gmail.com

# ========================================================
# Cryptographic Security Secrets (CSPRNG 256-bit entropy)
# ========================================================
SECRET_KEY=generate_a_random_32_byte_hex_string_here
SECURITY_PEPPER=generate_another_random_32_byte_hex_string_here

# Set to false in production (never expose OTP in API JSON responses)
ALLOW_DEV_OTP_RESPONSE=false
